<Window x:Class="TciMeter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCI-Meter" Icon="Assets/app.ico" Width="760" Height="600" MinWidth="380" MinHeight="300"
        Background="#181818" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Orange" Color="#EC9A45" />
        <SolidColorBrush x:Key="OrangeDim" Color="#B0703A" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Orange}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="14" Background="#0E0E0E" BorderBrush="#2E2E2E" BorderThickness="1"
            ClipToBounds="True">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Einstellungen ..." Click="OnSettings" />
                <MenuItem Header="Immer im Vordergrund" IsCheckable="True" Click="OnTopmost" />
                <MenuItem Header="Info ..." Click="OnAbout" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Meter: background image + needle overlay, both in 1200x600 image coordinates -->
            <Viewbox Grid.Row="0" Stretch="Uniform">
                <Grid Width="1200" Height="600">
                    <Image Source="Assets/meter.png" Width="1200" Height="600" Stretch="Fill" />

                    <Canvas Width="1200" Height="600" ClipToBounds="True" IsHitTestVisible="False">
                        <!-- Main needle: S (RX) / PO (TX) -->
                        <Polygon x:Name="MainNeedle" Points="-0.6,-462 0.6,-462 3.5,30 -3.5,30" Fill="#F2F2F2">
                            <Polygon.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="300" Opacity="0.7" />
                            </Polygon.Effect>
                            <Polygon.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="MainRot" />
                                    <TranslateTransform X="603" Y="548" />
                                </TransformGroup>
                            </Polygon.RenderTransform>
                        </Polygon>

                        <!-- Hub -->
                        <Ellipse Width="56" Height="56" Canvas.Left="575" Canvas.Top="520" StrokeThickness="3">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#777" Offset="0" />
                                    <GradientStop Color="#111" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Color="#555" Offset="0" />
                                    <GradientStop Color="#111" Offset="0.7" />
                                    <GradientStop Color="#000" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock x:Name="TrxBadge" Text="RX" FontSize="30" FontWeight="SemiBold"
                                   Canvas.Left="1090" Canvas.Top="10" Width="90" TextAlignment="Right" />
                    </Canvas>
                </Grid>
            </Viewbox>

            <!-- Readouts -->
            <Border Grid.Row="1" Background="#121212" BorderBrush="#222" BorderThickness="0,1,0,0" Padding="18,12,18,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="BandText" Text="--" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="ModeText" Text="--" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="FreqText" Text="-.---.---" FontSize="40" FontWeight="Bold" />
                        <TextBlock x:Name="FreqUnit" Text="MHz" FontSize="12" Foreground="{StaticResource OrangeDim}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="LevelText" Text="--- dBm" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="SnrText" Text="SNR -- dB" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="FooterText" HorizontalAlignment="Left"
                               Margin="0,8,0,0" FontSize="11" Foreground="#777" Text="Connecting ..." />
                    <Button Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" Content="⚙" FontSize="16"
                            Foreground="#B0703A" Background="Transparent" BorderThickness="0" Padding="6,0"
                            Cursor="Hand" ToolTip="Einstellungen" Click="OnSettings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
