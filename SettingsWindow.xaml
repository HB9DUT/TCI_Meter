<Window x:Class="TciMeter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Icon="Assets/app.ico" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#181818">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EC9A45" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="170" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="#0E0E0E" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="CaretBrush" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="#444" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Station" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Rufzeichen" />
            <TextBox Grid.Column="1" x:Name="CallBox" MaxLength="15" CharacterCasing="Upper"
                     ToolTip="Wird im Fenstertitel angezeigt" />
        </Grid>

        <TextBlock Text="TCI-Server" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Host" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" />
            <TextBlock Grid.Row="1" Text="Port" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="PortBox" />
            <TextBlock Grid.Row="2" Text="Receiver (RX)" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="RxBox" />
            <TextBlock Grid.Row="3" Text="Kanal (0 = A, 1 = B)" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ChBox" />
            <TextBlock Grid.Row="4" Text="PO max (W)" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="PowerBox" />
            <TextBlock Grid.Row="5" Text="Senden (auch Tune)" VerticalAlignment="Top" Margin="0,8,0,0" />
            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
                <RadioButton x:Name="TxPowerRadio" Content="Sendeleistung (PO)" GroupName="TxMeter" />
                <RadioButton x:Name="TxSwrRadio" Content="SWR" GroupName="TxMeter" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="#FF5050" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="320" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Standard" Click="OnDefaults" ToolTip="localhost : 50001" />
            <Button Content="OK" IsDefault="True" Click="OnOk" />
            <Button Content="Abbrechen" IsCancel="True" />
        </StackPanel>

        <TextBlock x:Name="CopyrightText" Foreground="#777" FontSize="11" HorizontalAlignment="Center"
                   Margin="0,16,0,0" />
    </StackPanel>
</Window>
